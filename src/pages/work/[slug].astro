---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projectDetails } from "../../data/projects";

export function getStaticPaths() {
  return Object.values(projectDetails).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Paulina Reller`} description={project.summary}>
  <Nav />
  <main id="main">
    <section class="case-hero">
      <div class="container">
        <a href="/#work" class="back mono">← Back to work</a>

        <h1>{project.title}</h1>
        <p class="subtitle">{project.subtitle}</p>

        <div class="meta">
          <div>
            <span class="mono label">{project.client ? "Client" : "Org"}</span>
            <p>{project.client ? `${project.client} - ${project.org}` : project.org}</p>
          </div>
          <div>
            <span class="mono label">Role</span>
            <p>{project.role}</p>
          </div>
          <div>
            <span class="mono label">Timeline</span>
            <p>{project.period}</p>
          </div>
        </div>
      </div>

      <div class="hero-image">
        {
          project.hero.type === "video" ? (
            <video
              autoplay
              muted
              loop
              playsinline
              poster={project.hero.poster}
              aria-label={`${project.title} hero video loop`}
            >
              <source src={project.hero.src} type="video/mp4" />
            </video>
          ) : project.hero.type === "image" ? (
            <img src={project.hero.src} alt={`${project.title} - product screen`} />
          ) : project.hero.type === "orb" ? (
            <canvas
              class="hero-canvas"
              data-orb
              aria-label={`${project.title} - neural network sphere visualization`}
            />
          ) : (
            <canvas
              class="hero-canvas"
              data-typo
              data-words={JSON.stringify(project.hero.words)}
              aria-label={`${project.title} - animated series topics: ${project.hero.words.join(", ")}`}
            />
          )
        }
      </div>
    </section>

    <section class="statement">
      <div class="container statement-grid">
        <span class="eyebrow eyebrow--light">The brief</span>
        <p>{project.summary}</p>
      </div>
    </section>

    <section class="problem">
      <div class="container problem-grid">
        <h2 class="section-title">The problem</h2>
        <p>{project.problem}</p>
      </div>
    </section>

    <section class="approach">
      <div class="container">
        <span class="eyebrow">How it's wired together</span>
        <h2 class="section-title">Architecture</h2>

        <div class="approach-grid">
          {
            project.approach.map((step, i) => (
              <div class="approach-row">
                <span class="mono index">{String(i + 1).padStart(2, "0")}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {(project.demo || project.screens) && (
    <section class="mockups">
      <div class="container">
        <span class="eyebrow">See it in action</span>
        <h2 class="section-title">
          {project.demo ? "Live demo" : "Product screens"}
        </h2>
        <p class="mockups-note">
          {project.demo ? project.demo.caption : project.screensNote}
        </p>

        {
          project.demo ? (
            <div class="demo-frame">
              <div class="mockup-bar">
                <span />
                <span />
                <span />
                <span class="mockup-bar-label mono">
                  {project.title.toLowerCase().replace(/\s+/g, "-")}
                  /engine-player
                </span>
              </div>
              <iframe
                src={project.demo.src}
                title={`${project.title} - live demo`}
                loading="lazy"
              />
            </div>
          ) : (
            <div class="mockup-grid">
              {project.screens.map((screen) => (
                <figure class="mockup-card">
                  <div class="mockup-frame">
                    <div class="mockup-bar">
                      <span />
                      <span />
                      <span />
                    </div>
                    <img src={screen.src} alt={`${project.title} - ${screen.label}`} />
                  </div>
                  <figcaption class="mono">{screen.label}</figcaption>
                </figure>
              ))}
            </div>
          )
        }
      </div>
    </section>
    )}

    <section class="features">
      <div class="container">
        <span class="eyebrow eyebrow--light">What I built</span>
        <h2 class="section-title">Features</h2>

        <div class="feature-grid">
          {
            project.features.map((feature, i) => (
              <article>
                <b class="mono">{String(i + 1).padStart(2, "0")}</b>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {project.quote && (
      <section class="testimonial">
        <div class="container">
          <blockquote>
            <p>“{project.quote.text}”</p>
            <cite class="mono">
              {project.quote.author} - {project.quote.role}
            </cite>
          </blockquote>
        </div>
      </section>
    )}

  </main>
  <Footer />
</Layout>

<style>
  .case-hero {
    padding-top: 2.5rem;
    padding-bottom: 0;
  }

  .back {
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 2rem;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    letter-spacing: -0.075em;
    margin: 0;
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 800;
    line-height: 0.92;
  }

  .subtitle {
    max-width: 40rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: var(--muted);
  }

  .meta {
    border-top: 1px solid var(--ink);
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    display: grid;
  }

  .meta .label {
    color: var(--muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .meta p {
    margin: 0;
    font-weight: 600;
  }

  .hero-image {
    aspect-ratio: 16 / 9;
    margin-top: 3rem;
    overflow: hidden;
  }

  .hero-image:has(canvas[data-typo]) {
    aspect-ratio: 21 / 6;
  }

  .hero-image video,
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-canvas {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--ink);
  }

  .statement {
    background: var(--ink);
    color: var(--paper);
  }

  .eyebrow--light {
    color: var(--paper);
  }

  .statement-grid {
    grid-template-columns: 1fr 2fr;
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    gap: 2rem;
    display: grid;
  }

  .statement-grid p {
    letter-spacing: -0.02em;
    margin: 0;
    font-size: clamp(1.4rem, 2.8vw, 2.4rem);
    line-height: 1.3;
  }

  .problem {
    border-top: 1px solid var(--ink);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .problem-grid {
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    display: grid;
  }

  .problem-grid p {
    max-width: 40rem;
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .mockups {
    border-top: 1px solid var(--ink);
    padding-top: clamp(5rem, 9vw, 8rem);
    padding-bottom: clamp(6rem, 10vw, 9rem);
    overflow: hidden;
  }

  .mockups h2 {
    margin-top: 1rem;
  }

  .mockups-note {
    max-width: 34rem;
    color: var(--muted);
    margin: 1.5rem 0 0;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .mockup-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    justify-content: center;
    gap: 3rem;
    margin-top: clamp(4rem, 7vw, 6rem);
    padding: 2rem 0 3rem;
    display: grid;
  }

  .mockup-card {
    max-width: 26rem;
    margin: 0 auto;
    perspective: 1600px;
  }

  .mockup-frame {
    transform: rotateY(-14deg) rotateX(4deg) rotateZ(1deg);
    transform-style: preserve-3d;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 1.5rem 2rem 2.5rem -1.75rem #11111145;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .mockup-card:nth-child(2) .mockup-frame {
    transform: rotateY(0deg) rotateX(2deg) translateY(-1rem);
  }

  .mockup-card:nth-child(3) .mockup-frame {
    transform: rotateY(14deg) rotateX(4deg) rotateZ(-1deg);
  }

  .mockup-card:hover .mockup-frame {
    transform: rotateY(0deg) rotateX(0deg) translateY(-0.5rem) scale(1.03);
    box-shadow: 1.5rem 2.5rem 3rem -1.5rem #11111160;
  }

  .mockup-bar {
    background: var(--ink);
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    display: flex;
  }

  .mockup-bar span {
    background: var(--paper);
    opacity: 0.4;
    border-radius: 50%;
    width: 0.5rem;
    height: 0.5rem;
    display: block;
  }

  .mockup-bar span:first-child {
    background: var(--acid);
    opacity: 1;
  }

  .mockup-bar-label {
    color: var(--muted);
    background: none !important;
    border-radius: 0 !important;
    width: auto !important;
    height: auto !important;
    opacity: 1 !important;
    margin-left: 0.5rem;
  }

  .demo-frame {
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 1.5rem 2rem 2.5rem -1.75rem #11111145;
    overflow: hidden;
  }

  .demo-frame iframe {
    width: 100%;
    height: clamp(28rem, 60vw, 42rem);
    border: 0;
    display: block;
  }

  .mockup-frame img {
    width: 100%;
    display: block;
  }

  .mockup-card figcaption {
    color: var(--muted);
    text-align: center;
    margin-top: 1.5rem;
  }

  .approach {
    border-top: 1px solid var(--ink);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .approach h2 {
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  .approach-grid {
    border-top: 1px solid var(--ink);
  }

  .approach-row {
    border-bottom: 1px solid var(--line);
    grid-template-columns: 3rem 1fr 2fr;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.75rem;
    display: grid;
  }

  .approach-row .index {
    color: var(--acid);
  }

  .approach-row h3 {
    letter-spacing: -0.03em;
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
  }

  .approach-row p {
    margin: 0;
    max-width: 34rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .features {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .features h2 {
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  .feature-grid {
    border-top: 1px solid var(--paper);
    border-left: 1px solid var(--paper);
    grid-template-columns: repeat(3, 1fr);
    display: grid;
  }

  .feature-grid article {
    border-right: 1px solid var(--paper);
    border-bottom: 1px solid var(--paper);
    flex-direction: column;
    min-height: 260px;
    padding: 1.5rem;
    transition: background 0.3s, color 0.3s;
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .feature-grid article:hover {
    background: var(--acid);
    color: var(--ink);
  }

  .feature-grid b {
    letter-spacing: -0.08em;
    color: var(--acid);
    opacity: 0.25;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    transition: opacity 0.3s;
    position: absolute;
    top: 1.25rem;
    right: 1rem;
  }

  .feature-grid article:hover b {
    color: var(--ink);
    opacity: 0.2;
  }

  .feature-grid h3 {
    letter-spacing: -0.03em;
    margin: auto 0 0.5rem;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.15;
  }

  .feature-grid p {
    margin: 0;
    max-width: 20rem;
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  .testimonial {
    background: var(--ink);
    color: var(--paper);
    border-top: 1px solid var(--ink);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .testimonial blockquote {
    margin: 0;
    max-width: 42rem;
  }

  .testimonial p {
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    line-height: 1.35;
  }

  .testimonial cite {
    color: var(--paper);
    opacity: 0.65;
    font-style: normal;
  }

  @media (width <= 800px) {
    .meta {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .statement-grid,
    .problem-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .mockup-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .mockup-frame,
    .mockup-card:nth-child(2) .mockup-frame,
    .mockup-card:nth-child(3) .mockup-frame {
      transform: none;
    }

    .mockup-card:hover .mockup-frame {
      transform: none;
    }

    .approach-row {
      grid-template-columns: 2.5rem 1fr;
    }

    .approach-row h3 {
      grid-column: 2;
    }

    .approach-row p {
      grid-column: 2;
    }
  }
</style>

<script>
  const orbCanvas = document.querySelector<HTMLCanvasElement>("canvas[data-orb]");
  const typoCanvas = document.querySelector<HTMLCanvasElement>("canvas[data-typo]");

  if (orbCanvas) {
    const canvas = orbCanvas;
    const ctx = canvas.getContext("2d")!;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const styles = getComputedStyle(document.documentElement);
    const acid = styles.getPropertyValue("--acid").trim() || "#ff4d00";
    const paper = styles.getPropertyValue("--paper").trim() || "#f1f0ea";

    type Point = { x: number; y: number; z: number };

    const COUNT = 170;
    const LINK_DIST = 0.62;
    const points: Point[] = [];

    // Fibonacci sphere distribution
    const goldenAngle = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < COUNT; i++) {
      const y = 1 - (i / (COUNT - 1)) * 2;
      const radius = Math.sqrt(1 - y * y);
      const theta = goldenAngle * i;
      points.push({ x: Math.cos(theta) * radius, y, z: Math.sin(theta) * radius });
    }

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();
    window.addEventListener("resize", resize);

    function hexToRgb(hex: string) {
      const clean = hex.replace("#", "");
      const bigint = parseInt(clean.length === 3
        ? clean.split("").map((c) => c + c).join("")
        : clean, 16);
      return { r: (bigint >> 16) & 255, g: (bigint >> 8) & 255, b: bigint & 255 };
    }

    const acidRgb = hexToRgb(acid);
    const paperRgb = hexToRgb(paper);

    function draw(t: number) {
      ctx.clearRect(0, 0, width, height);

      const scale = Math.min(width, height) * 0.58;
      const cx = width / 2;
      const cy = height / 2;
      const pulse = 1 + Math.sin(t * 0.9) * 0.02;

      const ay = t * 0.18;
      const ax = Math.sin(t * 0.25) * 0.35 + 0.15;
      const cosY = Math.cos(ay), sinY = Math.sin(ay);
      const cosX = Math.cos(ax), sinX = Math.sin(ax);

      const projected: { x: number; y: number; z: number; p: Point }[] = [];

      for (const p of points) {
        // rotate around Y
        let x = p.x * cosY - p.z * sinY;
        let z = p.x * sinY + p.z * cosY;
        let y = p.y;
        // rotate around X
        const y2 = y * cosX - z * sinX;
        const z2 = y * sinX + z * cosX;
        y = y2;
        z = z2;

        const perspective = 1 / (2 - z);
        const sx = cx + x * scale * pulse * perspective;
        const sy = cy + y * scale * pulse * perspective;
        projected.push({ x: sx, y: sy, z, p });
      }

      projected.sort((a, b) => a.z - b.z);

      // connections
      for (let i = 0; i < projected.length; i++) {
        for (let j = i + 1; j < projected.length; j++) {
          const a = projected[i].p;
          const b = projected[j].p;
          const dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
          const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
          if (dist < LINK_DIST) {
            const alpha = (1 - dist / LINK_DIST) * 0.35;
            const depth = (projected[i].z + projected[j].z) / 2;
            const glow = 0.5 + depth * 0.5;
            ctx.strokeStyle = `rgba(${paperRgb.r}, ${paperRgb.g}, ${paperRgb.b}, ${alpha * glow})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(projected[i].x, projected[i].y);
            ctx.lineTo(projected[j].x, projected[j].y);
            ctx.stroke();
          }
        }
      }

      // nodes
      for (const node of projected) {
        const depth = (node.z + 1) / 2;
        const r = 1.1 + depth * 2;
        const flicker = 0.55 + Math.sin(t * 2 + node.p.x * 6) * 0.25;
        ctx.beginPath();
        ctx.fillStyle = `rgba(${acidRgb.r}, ${acidRgb.g}, ${acidRgb.b}, ${0.35 + depth * 0.55 * flicker})`;
        ctx.arc(node.x, node.y, r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    if (reduceMotion) {
      draw(0);
    } else {
      let start: number | null = null;
      function frame(now: number) {
        if (start === null) start = now;
        const t = (now - start) / 1000;
        draw(t);
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }
  }

  if (typoCanvas) {
    const canvas = typoCanvas;
    const ctx = canvas.getContext("2d")!;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const styles = getComputedStyle(document.documentElement);
    const acid = styles.getPropertyValue("--acid").trim() || "#ff4d00";
    const paper = styles.getPropertyValue("--paper").trim() || "#f1f0ea";
    const ink = styles.getPropertyValue("--ink").trim() || "#111111";

    const words: string[] = JSON.parse(canvas.dataset.words || "[]");
    const STAGGER_MS = 420;
    const ENTER_MS = 320;
    const HOLD_MS = 1100;
    const EXIT_MS = 400;
    const buildEnd = Math.max(0, words.length - 1) * STAGGER_MS + ENTER_MS;
    const cycleLength = buildEnd + HOLD_MS + EXIT_MS;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();
    window.addEventListener("resize", resize);

    function easeOutBack(x: number) {
      const c1 = 1.5, c3 = c1 + 1;
      return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
    }

    function draw(t: number) {
      ctx.fillStyle = ink;
      ctx.fillRect(0, 0, width, height);
      if (!words.length) return;

      const cycle = t % cycleLength;

      let fontSize = Math.min(width * 0.1, height * 0.5);
      ctx.font = `800 ${fontSize}px Helvetica, Arial, sans-serif`;
      const spacing = fontSize * 0.32;
      let totalWidth = words.reduce((sum, w) => sum + ctx.measureText(w).width, 0)
        + spacing * (words.length - 1);

      const maxWidth = width * 0.92;
      if (totalWidth > maxWidth) {
        fontSize *= maxWidth / totalWidth;
        ctx.font = `800 ${fontSize}px Helvetica, Arial, sans-serif`;
        totalWidth = words.reduce((sum, w) => sum + ctx.measureText(w).width, 0)
          + fontSize * 0.32 * (words.length - 1);
      }

      const scaledSpacing = fontSize * 0.32;
      const barHeight = Math.max(fontSize * 0.07, 3);
      const barY = fontSize * 0.42;

      let lineOpacity = 1;
      let lineScale = 1;
      if (cycle > buildEnd + HOLD_MS) {
        const p = (cycle - buildEnd - HOLD_MS) / EXIT_MS;
        lineOpacity = 1 - p;
        lineScale = 1 - p * 0.05;
      }

      ctx.textBaseline = "middle";
      ctx.textAlign = "left";

      let x = width / 2 - totalWidth / 2;
      const cy = height / 2;

      ctx.save();
      ctx.globalAlpha = lineOpacity;
      ctx.translate(0, cy);
      ctx.scale(lineScale, lineScale);
      ctx.translate(0, -cy);

      for (let i = 0; i < words.length; i++) {
        const word = words[i];
        const appearAt = i * STAGGER_MS;
        const wordWidth = ctx.measureText(word).width;

        let wScale = 1;
        let wOpacity = 1;
        let barProgress = 1;

        if (cycle < appearAt) {
          wOpacity = 0;
          barProgress = 0;
        } else if (cycle < appearAt + ENTER_MS) {
          const p = (cycle - appearAt) / ENTER_MS;
          wScale = 0.7 + easeOutBack(p) * 0.3;
          wOpacity = Math.min(p * 1.6, 1);
          barProgress = p;
        }

        if (wOpacity > 0) {
          ctx.save();
          ctx.globalAlpha = lineOpacity * wOpacity;
          ctx.translate(x + wordWidth / 2, cy);
          ctx.scale(wScale, wScale);

          ctx.fillStyle = acid;
          ctx.fillRect(-wordWidth / 2, barY, wordWidth * barProgress, barHeight);

          ctx.fillStyle = paper;
          ctx.fillText(word, -wordWidth / 2, 0);
          ctx.restore();
        }

        x += wordWidth + scaledSpacing;
      }

      ctx.restore();
    }

    if (reduceMotion) {
      draw(0);
    } else {
      let start: number | null = null;
      function frame(now: number) {
        if (start === null) start = now;
        const t = now - start;
        draw(t);
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }
  }
</script>
