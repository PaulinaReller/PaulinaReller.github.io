---
import { profile } from "../data/content";
---

<section
  id="contact"
  class="px-6 md:px-12 py-24 md:py-40 border-t border-white/10"
>
  <div class="flex flex-col items-start">
    <span class="text-xs uppercase tracking-wider opacity-40 mb-6">
      Get in touch
    </span>
    <a
      href={`mailto:${profile.email}`}
      class="font-display text-[10vw] md:text-[5.5vw] leading-none font-medium tracking-tight hover:text-[color:var(--color-accent)] transition-colors"
    >
      {profile.email}
    </a>

    <div class="mt-16 flex flex-wrap gap-x-12 gap-y-4 text-sm">
      <span class="opacity-50">{profile.phone}</span>
      <span class="opacity-50">{profile.location}</span>
      {
        profile.socials.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith("http") ? "_blank" : undefined}
            rel="noreferrer"
            class="opacity-70 hover:opacity-100 underline underline-offset-4"
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
