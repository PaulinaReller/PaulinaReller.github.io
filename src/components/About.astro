---
import { profile, education } from "../data/content";
---

<section id="about" class="px-6 md:px-12 py-24 md:py-32 border-t border-white/10">
  <div class="grid md:grid-cols-12 gap-8 md:gap-12">
    <h2 class="md:col-span-4 font-display text-4xl md:text-6xl font-medium tracking-tight">
      About
    </h2>
    <div class="md:col-span-6 md:col-start-6">
      <p class="text-xl md:text-2xl font-display leading-snug">
        {profile.about}
      </p>

      <div class="mt-16 space-y-6">
        {
          education.map((edu) => (
            <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 border-t border-white/10 pt-4">
              <div>
                <p class="font-medium">{edu.school}</p>
                <p class="text-sm opacity-60">{edu.degree}</p>
              </div>
              <span class="text-sm opacity-40 whitespace-nowrap">
                {edu.period}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
