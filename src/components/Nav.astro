---
const links = [
  { label: "Work", href: "#work" },
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
];
---

<header class="header">
  <nav id="site-nav">
    {
      links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))
    }
    <a href="#contact" class="contact">
      <span>Let's talk</span>
      <span>↗</span>
    </a>
  </nav>

  <button class="menu-toggle mono" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">
    Menu +
  </button>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--ink);
    align-items: center;
    justify-content: space-between;
    height: 92px;
    display: flex;
    padding-inline: var(--pad);
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 80;
    opacity: 1;
    transition: height 0.25s ease, opacity 0.25s ease;
  }

  .header.scrolled {
    height: 56px;
    opacity: 0.7;
  }

  .header.scrolled:hover {
    opacity: 1;
  }

  nav {
    grid-template-columns: repeat(3, 1fr) 1.4fr;
    align-items: center;
    height: 100%;
    flex: 1;
    display: grid;
  }

  nav a {
    border-left: 1px solid var(--line);
    align-items: center;
    height: 100%;
    padding-inline: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
    display: flex;
    position: relative;
  }

  nav a:hover {
    background: #1111110e;
  }

  .contact {
    background: var(--ink);
    color: var(--paper);
    justify-content: space-between;
  }

  .contact:hover {
    background: var(--acid);
    color: var(--ink);
  }

  .menu-toggle {
    background: 0 0;
    border: 0;
    display: none;
  }

  @media (width <= 850px) {
    .header {
      height: 72px;
    }

    .header.scrolled {
      height: 48px;
    }

    .menu-toggle {
      margin-left: auto;
      display: block;
    }

    nav {
      z-index: 90;
      background: var(--paper);
      border-bottom: 1px solid var(--ink);
      display: none;
      position: fixed;
      inset: 72px 0 auto;
      grid-template-columns: 1fr;
    }

    nav.open {
      display: grid;
    }

    nav a {
      border-left: 0;
      border-top: 1px solid var(--line);
      height: 64px;
      padding-inline: var(--pad);
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("site-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  nav?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      nav.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );

  const header = document.querySelector(".header");
  const setScrolled = () => header?.classList.toggle("scrolled", window.scrollY > 40);
  setScrolled();
  document.addEventListener("scroll", setScrolled, { passive: true });
</script>
