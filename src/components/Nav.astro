---
import { profile } from "../data/content";

const links = [
  { label: "Work", href: "#work" },
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 mix-blend-difference">
  <nav
    class="flex items-center justify-between px-6 py-6 md:px-12 font-display"
  >
    <a href="#top" class="text-sm font-medium tracking-tight">
      {profile.name}
    </a>
    <ul class="hidden md:flex items-center gap-8 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="opacity-70 hover:opacity-100 transition-opacity"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="#contact"
      class="text-sm border border-current rounded-full px-4 py-1.5 hover:opacity-70 transition-opacity"
    >
      Let's talk
    </a>
  </nav>
</header>
