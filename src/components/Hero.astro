---
import { profile } from "../data/content";
---

<section id="top" class="hero">
  <div class="container">
    <div class="hero-top">
      <p class="hero-note mono">
        {profile.role} - currently working at Impulse Audio Lab
      </p>
    </div>

    <h1 class="name-row">
      <span class="name-text">
        <span>Paulina</span>
        <span class="offset">Reller<span class="period">.</span></span>
      </span>
      <dotlottie-wc
        src="/animations/Artist.lottie"
        autoplay
        loop
        class="hero-lottie"
      ></dotlottie-wc>
    </h1>

    <div class="hero-bottom">
      <p class="mono"><span class="orb"></span>{profile.location}</p>
      <p>{profile.tagline}</p>
      <a href="#work" class="button">See the work</a>
    </div>
  </div>
</section>

<div class="statement">
  <div class="container statement-grid">
    <h2>
      Less polish. <em>More</em> proof it works.
    </h2>
    <p>
      I move between code and visual design - building modular, data-heavy
      frontends by day, and murals, editorial illustration, and product
      concepts on the side.
    </p>
  </div>
</div>

<style>
  .hero {
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .hero-top {
    justify-content: flex-end;
    display: flex;
  }

  .hero-note {
    width: 31%;
    margin: 0;
    font-size: 0.88rem;
    text-align: right;
  }

  .hero h1 {
    letter-spacing: -0.075em;
    margin: 2vw 0;
    font-size: clamp(4.7rem, 14.2vw, 14rem);
    font-weight: 800;
    line-height: 0.92;
  }

  .hero h1.name-row {
    align-items: center;
    justify-content: space-between;
    gap: 2vw;
    display: flex;
  }

  .name-text > span {
    display: block;
  }

  .hero-lottie {
    aspect-ratio: 4 / 3;
    width: auto;
    height: 1.9em;
    flex-shrink: 0;
  }

  .offset {
    padding-left: 8vw;
  }

  .period {
    color: var(--acid);
  }

  .orb {
    aspect-ratio: 1;
    vertical-align: -0.05em;
    background: var(--acid);
    border-radius: 50%;
    width: 0.68em;
    margin-right: 0.4em;
    display: inline-block;
  }

  .hero-bottom {
    border-top: 1px solid var(--ink);
    grid-template-columns: 1fr 1fr 1fr;
    align-items: end;
    gap: 2rem;
    padding-top: 1.5rem;
    display: grid;
  }

  .hero-bottom p:nth-child(2) {
    white-space: nowrap;
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
  }

  .hero-bottom .button {
    justify-self: end;
  }

  .statement {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }

  .statement-grid {
    grid-template-columns: 1fr 3fr;
    padding-top: clamp(5rem, 10vw, 10rem);
    padding-bottom: clamp(5rem, 10vw, 10rem);
    display: grid;
  }

  .statement h2 {
    letter-spacing: -0.075em;
    grid-column: 2;
    margin: 0;
    font-size: clamp(4rem, 10vw, 10rem);
    line-height: 0.9;
    font-weight: 800;
  }

  .statement h2 em {
    color: var(--acid);
    font-family: Georgia, serif;
    font-weight: 400;
    font-style: italic;
  }

  .statement-grid > p:last-child {
    grid-column: 2;
    max-width: 36rem;
    margin: 4rem 0 0;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
  }

  @media (width <= 800px) {
    .hero-top {
      display: block;
    }

    .hero-note {
      display: none;
    }

    .hero h1 {
      font-size: clamp(4rem, 20vw, 8rem);
      line-height: 0.88;
    }

    .hero h1.name-row {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .hero-lottie {
      height: 1.3em;
    }

    .offset {
      padding-left: 0;
    }

    .hero-bottom {
      grid-template-columns: 1fr;
    }

    .hero-bottom .button {
      justify-self: start;
    }

    .hero-bottom > p:first-child {
      display: none;
    }

    .statement-grid {
      grid-template-columns: 1fr;
    }

    .statement h2,
    .statement-grid > p:last-child {
      grid-column: 1;
    }
  }
</style>

<script>
  import "@lottiefiles/dotlottie-wc";
</script>
