---
import { profile } from "../data/content";
---

<section id="top" class="hero">
  <div class="container">
    <div class="hero-top">
      <p class="hero-note mono">
        {profile.role} - currently working at Impulse Audio Lab
      </p>
    </div>

    <h1 class="name-row">
      <span class="name-text">
        <span>Paulina</span>
        <span class="offset">Reller<span class="period">.</span></span>
      </span>
      <dotlottie-wc
        src="/animations/Artist.lottie"
        autoplay
        loop
        class="hero-lottie"
      ></dotlottie-wc>
    </h1>

    <div class="hero-bottom">
      <p class="mono">{profile.location}</p>
      <a href="#work" class="button">See the work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .hero-top {
    justify-content: flex-end;
    display: flex;
  }

  .hero-note {
    width: 31%;
    margin: 0;
    font-size: 0.88rem;
    text-align: right;
  }

  .hero h1 {
    letter-spacing: -0.075em;
    margin: 2vw 0;
    font-size: clamp(4.7rem, 14.2vw, 14rem);
    font-weight: 800;
    line-height: 0.92;
  }

  .hero h1.name-row {
    align-items: center;
    justify-content: space-between;
    gap: 2vw;
    display: flex;
  }

  .name-text > span {
    display: block;
  }

  .hero-lottie {
    aspect-ratio: 4 / 3;
    width: auto;
    height: 1.9em;
    flex-shrink: 0;
  }

  .offset {
    padding-left: 8vw;
  }

  .period {
    color: var(--acid);
  }

  .hero-bottom {
    border-top: 1px solid var(--ink);
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    padding-top: 1.5rem;
    display: grid;
  }

  .hero-bottom .button {
    justify-self: end;
  }

  @media (width <= 800px) {
    .hero-top {
      display: block;
    }

    .hero-note {
      display: none;
    }

    .hero h1 {
      font-size: clamp(4rem, 20vw, 8rem);
      line-height: 0.88;
    }

    .hero h1.name-row {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .hero-lottie {
      height: 1.3em;
    }

    .offset {
      padding-left: 0;
    }

    .hero-bottom {
      grid-template-columns: 1fr;
    }

    .hero-bottom .button {
      justify-self: start;
    }
  }
</style>

<script>
  import "@lottiefiles/dotlottie-wc";
</script>
