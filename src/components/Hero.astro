---
import { profile } from "../data/content";
---

<section
  id="top"
  class="min-h-screen flex flex-col justify-between px-6 md:px-12 pt-32 pb-12"
>
  <div class="flex-1 flex items-center">
    <h1 class="font-display font-medium leading-[0.95] tracking-tight text-[13vw] md:text-[7.5vw]">
      {profile.name}
    </h1>
  </div>

  <div class="grid md:grid-cols-3 gap-6 md:gap-12 items-end">
    <p class="font-display text-2xl md:text-3xl leading-tight max-w-md">
      {profile.tagline}
    </p>
    <p class="text-sm opacity-60 leading-relaxed">
      {profile.role}. Currently working student at Impulse Audio Lab, based
      in {profile.location}.
    </p>
    <div class="flex md:justify-end items-end gap-2 text-sm opacity-60">
      <span class="animate-pulse text-[color:var(--color-accent)]">●</span>
      <span>Munich, Germany</span>
    </div>
  </div>
</section>
