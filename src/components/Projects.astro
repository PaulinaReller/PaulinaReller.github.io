---
import { projects } from "../data/content";
---

<section id="work" class="px-6 md:px-12 py-24 md:py-32 border-t border-white/10">
  <div class="flex items-end justify-between mb-16">
    <h2 class="font-display text-4xl md:text-6xl font-medium tracking-tight">
      Selected Work
    </h2>
    <span class="hidden md:block text-sm opacity-50">
      {String(projects.length).padStart(2, "0")} Projects
    </span>
  </div>

  <div class="flex flex-col">
    {
      projects.map((project, i) => (
        <a
          href={project.href}
          class="group grid md:grid-cols-12 gap-4 md:gap-8 items-center py-10 border-t border-white/10 last:border-b transition-colors hover:bg-white/[0.03] px-2 -mx-2"
        >
          <span class="md:col-span-1 text-sm opacity-40 font-display">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div class="md:col-span-5">
            <h3 class="font-display text-2xl md:text-4xl font-medium tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
              {project.title}
            </h3>
            <p class="text-sm opacity-50 mt-1">{project.subtitle}</p>
          </div>
          <p class="md:col-span-4 text-sm opacity-60 leading-relaxed">
            {project.description}
          </p>
          <div class="md:col-span-2 flex md:justify-end flex-wrap gap-2">
            {project.tags.slice(0, 3).map((tag) => (
              <span class="text-xs border border-white/20 rounded-full px-3 py-1 opacity-60">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>
