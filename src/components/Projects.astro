---
import { projects } from "../data/content";
---

<section id="work" class="work">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Selected Work</h2>
      <p>
        A handful of the products and prototypes I've built across code and
        design, from vehicle telemetry dashboards to health-tech UX.
      </p>
    </div>

    <div class="project-grid">
      {
        projects.map((project, i) => (
          <article>
            <a href={project.href} class="project-link">
              <span class="mono index">{String(i + 1).padStart(2, "0")}</span>
              <h3>
                {project.title}
                <span class="arrow">↗</span>
              </h3>
              <p class="subtitle">{project.subtitle} — {project.org}</p>
              <p class="description">{project.description}</p>
              <div class="tags">
                {project.tags.map((tag) => (
                  <span class="mono tag">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding-top: clamp(5rem, 10vw, 10rem);
    padding-bottom: clamp(5rem, 10vw, 10rem);
  }

  .section-head {
    grid-template-columns: 3fr 1fr;
    align-items: end;
    margin-bottom: 4rem;
    display: grid;
    gap: 2rem;
  }

  .section-head > p {
    max-width: 22rem;
    font-size: 1.1rem;
  }

  .project-grid {
    grid-template-columns: 1fr 1fr;
    gap: 2vw;
    display: grid;
  }

  .project-grid article:nth-child(2) {
    margin-top: 14vw;
  }

  .project-link {
    border-top: 1px solid var(--ink);
    padding-top: 1.5rem;
    display: block;
    text-decoration: none;
    transition: opacity 0.25s;
  }

  .project-link:hover {
    opacity: 0.6;
  }

  .index {
    color: var(--muted);
  }

  h3 {
    letter-spacing: -0.05em;
    margin: 0.75rem 0 0.5rem;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .arrow {
    color: var(--acid);
    font-size: 1.4rem;
  }

  .subtitle {
    color: var(--muted);
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }

  .description {
    margin: 0 0 1.5rem;
    max-width: 32rem;
    font-size: 1rem;
    line-height: 1.55;
  }

  .tags {
    flex-wrap: wrap;
    gap: 0.5rem;
    display: flex;
  }

  .tag {
    border: 1px solid var(--line);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    color: var(--muted);
  }

  @media (width <= 800px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .project-grid article:nth-child(2) {
      margin-top: 0;
    }
  }
</style>
