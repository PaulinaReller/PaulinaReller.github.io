---
import { experience, skills } from "../data/content";

type Skill = { name: string; level?: number };

const services: { label: string; items: Skill[] }[] = [
  { label: "Design", items: skills.design },
  { label: "Engineering", items: skills.engineering },
  { label: "Tools & Workflows", items: skills.tools },
  { label: "Languages", items: skills.languages },
  { label: "Spoken", items: skills.spoken },
];
---

<section id="experience" class="method">
  <div class="container">
    <div class="method-heading">
      <span class="eyebrow">Where I've worked</span>
      <h2 class="section-title">Experience</h2>
    </div>

    <div class="method-grid">
      {
        experience.map((job, i) => (
          <article>
            <b class="mono">{String(i + 1).padStart(2, "0")}</b>
            <span class="mono period">{job.period}</span>
            <h3>{job.role}</h3>
            <p class="org">{job.org}</p>
            <p>{job.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="services">
  <div class="container">
    <div class="services-intro">
      <span class="eyebrow">Skills</span>
      <p>Design, engineering, and the tools that carry both.</p>
    </div>

    {
      services.map((service) => (
        <div class="service">
          <h3>{service.label}</h3>
          <p class="skill-list">
            {service.items.map((item) => (
              <span class="skill">{item.name}</span>
            ))}
          </p>
          <span class="arrow">↗</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .method {
    padding-top: clamp(7rem, 12vw, 12rem);
    padding-bottom: clamp(7rem, 12vw, 12rem);
    border-top: 1px solid var(--ink);
  }

  .method-heading {
    margin-bottom: 3rem;
  }

  .method-heading h2 {
    margin-top: 1rem;
  }

  .method-grid {
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
    grid-template-columns: repeat(3, 1fr);
    display: grid;
  }

  .method-grid article {
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    flex-direction: column;
    min-height: 340px;
    padding: 1.5rem;
    transition: background 0.3s, color 0.3s;
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .method-grid article:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .method-grid b {
    letter-spacing: -0.08em;
    color: var(--acid);
    opacity: 0.14;
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 0.9;
    transition: opacity 0.3s, transform 0.4s;
    position: absolute;
    top: 1.25rem;
    right: 1rem;
  }

  .method-grid article:hover b {
    opacity: 1;
    transform: translateY(0.35rem);
  }

  .method-grid .period {
    color: var(--muted);
  }

  .method-grid article:hover .period {
    color: var(--paper);
    opacity: 0.7;
  }

  .method-grid h3 {
    letter-spacing: -0.03em;
    margin: auto 0 0.5rem;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.15;
  }

  .method-grid .org {
    color: var(--muted);
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }

  .method-grid article:hover .org {
    color: var(--paper);
    opacity: 0.7;
  }

  .method-grid article > p:last-child {
    max-width: 20rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .services {
    background: var(--acid);
    padding-block: clamp(5rem, 8vw, 8rem);
  }

  .services-intro {
    grid-template-columns: 1fr 3fr;
    margin-bottom: 3rem;
    display: grid;
    gap: 1rem;
  }

  .services-intro p {
    margin: 0;
    font-size: clamp(1.3rem, 2.5vw, 2.2rem);
  }

  .service {
    border-top: 1px solid var(--ink);
    grid-template-columns: 1fr 2fr auto;
    align-items: center;
    min-height: 100px;
    gap: 1rem;
    transition: padding 0.25s;
    display: grid;
  }

  .service:last-of-type {
    border-bottom: 1px solid var(--ink);
  }

  .service:hover {
    padding-inline: 1rem;
  }

  .service h3 {
    letter-spacing: -0.03em;
    margin: 0;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    line-height: 1;
  }

  .skill-list {
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0;
    display: flex;
  }

  .skill {
    border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    border-radius: 999px;
    align-items: baseline;
    padding: 0.2rem 0.6rem;
    font-size: 0.85rem;
    line-height: 1.2;
    display: inline-flex;
  }

  .service .arrow {
    font-size: 1.4rem;
    justify-self: end;
  }

  @media (width <= 800px) {
    .method-grid {
      grid-template-columns: 1fr 1fr;
    }

    .method-grid article {
      min-height: 300px;
    }

    .services-intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .service {
      grid-template-columns: 1fr auto;
    }

    .skill-list {
      display: none;
    }
  }

  @media (width <= 520px) {
    .method-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
