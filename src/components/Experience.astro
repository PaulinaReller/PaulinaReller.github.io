---
import { experience, skills } from "../data/content";
---

<section
  id="experience"
  class="px-6 md:px-12 py-24 md:py-32 border-t border-white/10"
>
  <div class="grid md:grid-cols-12 gap-8 md:gap-12">
    <h2 class="md:col-span-4 font-display text-4xl md:text-6xl font-medium tracking-tight">
      Experience
    </h2>

    <div class="md:col-span-8">
      <div class="flex flex-col">
        {
          experience.map((job) => (
            <div class="grid md:grid-cols-12 gap-2 md:gap-8 py-8 border-t border-white/10 last:border-b">
              <span class="md:col-span-3 text-sm opacity-40">
                {job.period}
              </span>
              <div class="md:col-span-9">
                <h3 class="font-display text-xl md:text-2xl font-medium">
                  {job.role}
                </h3>
                <p class="text-sm opacity-50 mt-1">{job.org}</p>
                <p class="text-sm opacity-70 leading-relaxed mt-3 max-w-2xl">
                  {job.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-16 grid sm:grid-cols-3 gap-8">
        <div>
          <p class="text-xs uppercase tracking-wider opacity-40 mb-3">
            Design
          </p>
          <ul class="space-y-1.5 text-sm opacity-70">
            {skills.design.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider opacity-40 mb-3">
            Tools & Workflows
          </p>
          <ul class="space-y-1.5 text-sm opacity-70">
            {skills.tools.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider opacity-40 mb-3">
            Languages
          </p>
          <ul class="space-y-1.5 text-sm opacity-70">
            {skills.languages.map((s) => <li>{s}</li>)}
          </ul>
          <p class="text-xs uppercase tracking-wider opacity-40 mb-3 mt-6">
            Spoken
          </p>
          <ul class="space-y-1.5 text-sm opacity-70">
            {skills.spoken.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
